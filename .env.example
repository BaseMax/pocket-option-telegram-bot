# ---- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC...
# Comma separated chat ids allowed to use the bot.
# Leave empty and the first chat that sends /start claims ownership.
TELEGRAM_ADMIN_IDS=

# ---- Pocket Option --------------------------------------------------------
# The auth frame captured from the browser. Any of these shapes works:
#   42["auth",{"session":"...","isDemo":1,"uid":123,"platform":1}]
#   42["auth",{"sessionToken":"...","uid":"123","lang":"en","isChart":1}]
#   {"sessionToken":"...","uid":"123"}
# Quote the value — it contains characters your shell would otherwise eat.
PO_DEMO_SSID=
PO_REAL_SSID=
# Only needed when the SSID above is a bare session string.
PO_DEMO_UID=
PO_REAL_UID=

# Optional endpoint overrides, comma separated, `url` or `url|origin`.
PO_DEMO_SERVERS=
PO_REAL_SERVERS=
# Starting guess for (broker clock - local clock) in seconds. Auto-corrected
# from the first order acknowledgement.
PO_SERVER_TIME_OFFSET=7200

# ---- Behaviour ------------------------------------------------------------
DB_PATH=./data/bot.sqlite
DISPLAY_TIMEZONE=Asia/Tehran
LOG_LEVEL=info

DEFAULT_AMOUNT=1
DEFAULT_TIMEFRAME_SECONDS=60
DEFAULT_DURATION_SECONDS=60
MIN_AMOUNT=1
MAX_AMOUNT=20000
MIN_DURATION_SECONDS=5
MAX_DURATION_SECONDS=43200

SESSION_IDLE_TTL_SECONDS=60
ORDER_ACK_TIMEOUT_SECONDS=10
ORDER_SETTLE_GRACE_SECONDS=90
